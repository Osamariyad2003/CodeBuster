# CodeBuster local dev – copy to .env and adjust
# Used by: docker compose, and by local runs (backend, worker, scripts)

# Database (must match docker-compose db service)
DATABASE_URL=postgresql+psycopg2://codebuster:codebuster_pass@localhost:5432/codebuster

# Redis (must match docker-compose redis service)
REDIS_URL=redis://localhost:6379/0

# GitHub App webhook – set for webhook signature verification
GITHUB_WEBHOOK_SECRET=your-webhook-secret-from-github-app

# Optional: S3-compatible storage (MinIO in docker)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=codebuster
S3_SECRET_KEY=codebuster_pass
S3_BUCKET=codebuster-artifacts

# Environment
ENVIRONMENT=development
