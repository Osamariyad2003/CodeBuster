# Flask Configuration
FLASK_SECRET_KEY=your-super-secret-flask-key-change-this

# GitHub OAuth Configuration (for user authentication)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# GitHub App Configuration (for API access)
GITHUB_APP_ID=your-github-app-id
# For private key, use GITHUB_APP_PRIVATE_KEY_PATH instead (see below)
# GITHUB_APP_PRIVATE_KEY_PATH=path/to/private-key.pem

# GitHub Webhook Secret (for verifying webhook signatures)
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Server Port
PORT=5000

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5174
FRONTEND_PORT=5174

# AI code review (optional). Priority: OpenAI (GPT-5.6) > Vertex AI > Gemini > Anthropic.

# OpenAI (GPT-5.6) – primary AI review engine.
# Get a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6

# Vertex AI (Google Cloud) – used when OpenAI is not configured.
# Requires: VERTEX_PROJECT_ID. Auth: GOOGLE_APPLICATION_CREDENTIALS (service account JSON) or
# gcloud auth application-default login; or set VERTEX_ACCESS_TOKEN (e.g. gcloud auth print-access-token).
# VERTEX_PROJECT_ID=your-gcp-project-id
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=gemini-2.0-flash

# Gemini (Google AI Studio) – used when neither OpenAI nor Vertex is configured.
# Get a key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Optional: Microsoft CodeReviewer (CodeBERT) for diff-based review comments.
# Requires: pip install -r requirements-codereviewer.txt (torch, transformers).
# See https://github.com/microsoft/CodeBERT/tree/master/CodeReviewer
# CODEREVIEWER_ENABLED=0
# CODEREVIEWER_MODEL=microsoft/codereviewer

# Redis (required for Celery job queue). Use Redis Cloud or local Redis.
# REDIS_URL=redis://localhost:6379/0

# When Redis is unreachable (e.g. firewall, no Celery worker), run scans in-process instead of queue.
# Set to 1 to enable; scan runs in a background thread and results appear after refresh.
# RUN_SCAN_INLINE=0

